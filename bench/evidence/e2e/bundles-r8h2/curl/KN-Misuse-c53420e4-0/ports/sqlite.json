  "rationale": {
    "data_provider": "These return pointers to length-delimited BLOB buffers that are not guaranteed to be NUL-terminated within their byte length.",
    "length_provider": "These return the byte length of the BLOB or TEXT value associated with the same sqlite3_stmt column or sqlite3_value.",
    "unbounded_string_consumer": "These functions or printf-style formatters require a NUL-terminated C string and will read beyond a length-delimited buffer if it lacks an embedded NUL.",
    "bounded_nul_scanner": "memchr is the standard C function used to scan a buffer within an explicit length for a NUL byte, providing the bounded check needed by the fix.",
    "bounded_string_formatter": "The fix uses the standard printf precision specifier %.*s in existing printf-like functions; no project-specific function name is required."
  },
  "llm_seconds": 153.6
