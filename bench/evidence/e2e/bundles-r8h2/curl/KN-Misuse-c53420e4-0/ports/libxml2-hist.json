  "rationale": {
    "data_provider": "These functions produce or expose length-delimited byte buffers without guaranteeing a NUL terminator within the buffer length.",
    "length_provider": "These functions return or set the byte length associated with the corresponding length-delimited buffer.",
    "unbounded_string_consumer": "These functions and printf-style formatters consume C strings and require NUL termination, so passing a length-delimited buffer to them can cause out-of-bounds reads.",
    "bounded_nul_scanner": "memchr scans a buffer within an explicit length for a NUL byte, which is the bounded replacement for unbounded string operations.",
    "bounded_string_formatter": "libxml2 has no dedicated bounded string formatter; safe formatting is done in-place using the %.*s precision specifier in the existing printf-style functions."
  },
  "llm_seconds": 181.6
