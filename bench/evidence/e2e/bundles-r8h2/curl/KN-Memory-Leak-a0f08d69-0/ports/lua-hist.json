    "cleanup": "luaF_closeupval closes open upvalues, clearing the open-union link metadata used by luaF_unlinkupval.",
    "destructor": "luaF_freeupval destroys an UpVal and may call luaF_unlinkupval when the upvalue is still open.",
    "state_reset": "Closing an upvalue overwrites the union with the closed value, effectively zeroing the link storage used by the detach operation.",
    "link_detach": "luaF_unlinkupval detaches an open upvalue from the thread's open-upvalue list.",
