  "rationale": {
    "encoded_size_calculator": "Computes a new buffer size from the requested size and current buffer length, expanding the input length and potentially overflowing.",
    "input_length": "luaL_len obtains lengths that feed into buffer operations, and luaL_addsize manipulates the buffer length field B->n, which is the input length to luaL_prepbuffsize.",
    "max_input_size": "Lua's luaL_prepbuffsize guards overflow with a dynamic comparison (newsize < sz), not a constant maximum input size.",
    "error_sentinel": "Signals the overflow error by throwing a Lua error rather than returning a sentinel value."
  },
