  "rationale": {
    "resource": "Lua has no equivalent function that consumes an owned resource and frees it on failure, so the resource role is empty.",
    "ownership_consumer_frees_on_failure": "Lua's internal allocation wrappers raise errors instead of returning NULL, so there is no function that takes ownership of a resource and releases it on failure.",
    "deallocator": "These are Lua's general-purpose memory free functions, object-specific destroyers, and user-state cleanup wrappers.",
    "null_on_failure": "Lua does not use NULL returns for internal allocation failures; memory errors are thrown as exceptions.",
    "duplicate_cleanup": "A duplicate cleanup would be an erroneous call to one of the same deallocators in an error path.",
    "context_cleanup": "lua_close frees a lua_State and luaE_freethread frees a thread; these are the context deallocators whose ownership stays with the caller."
  },
  "llm_seconds": 500.9
