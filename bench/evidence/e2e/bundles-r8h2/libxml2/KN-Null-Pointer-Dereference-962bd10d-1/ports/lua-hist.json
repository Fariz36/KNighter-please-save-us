  "rationale": {
    "nullable_inout_capacity_ptr": "The `size` parameter of `luaM_growaux_` is an in/out capacity pointer that is dereferenced without a preceding null check.",
    "capacity_computer": "Lua computes the new capacity inline inside `luaM_growaux_`; there is no separate capacity-computing function equivalent to `xmlGrowCapacity`.",
    "reallocator": "These are Lua's general-purpose reallocation functions and wrappers, including the allocator hook `frealloc` and the test allocator `debug_realloc`.",
    "deref_read": "This is a generic dereference operation; no named function or macro specifically represents it in Lua.",
    "deref_write": "This is a generic dereference operation; no named function or macro specifically represents it in Lua.",
    "null_guard": "Lua has no project-specific null guard for capacity pointer parameters.",
    "null_on_failure": "Lua reallocators throw on allocation failure rather than returning NULL, so there is no matching NULL-failure condition."
  },
