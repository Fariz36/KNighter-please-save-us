  "rationale": {
    "nullable_inout_capacity_ptr": "Curl has no function taking a pointer to an in/out capacity slot like xmlGrowArray's capacity parameter.",
    "capacity_computer": "Curl has no function that computes a new capacity from a current capacity value; resize functions take the new size directly.",
    "reallocator": "These are curl's general-purpose reallocation wrappers and object-specific resize functions that reallocate memory.",
    "deref_read": "No equivalent expression role; curl's capacity management does not read through a passed capacity pointer.",
    "deref_write": "No equivalent expression role; curl's capacity management does not write through a passed capacity pointer.",
    "null_guard": "The null guard is a code pattern, not represented by a curl function or macro.",
    "null_on_failure": "These allocator/reallocator functions return NULL on allocation failure, matching the failure condition role."
  },
