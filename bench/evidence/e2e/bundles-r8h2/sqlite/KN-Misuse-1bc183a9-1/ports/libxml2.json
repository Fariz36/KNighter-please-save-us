  "rationale": {
    "tokenizer": "libxml2's XML and XPath parsers do not have a tokenizer that returns a token length and writes a token type to an out-parameter with an illegal-token sentinel.",
    "dequote_helper": "libxml2 dequotes quoted strings inline in parsing functions like xmlParseAttValue and xmlXPathCompLiteral, without a separate helper that assumes a valid token.",
    "illegal_token_sentinel": "libxml2 parsers use NULL or specific error codes rather than a dedicated illegal-token sentinel constant.",
    "dequoter_with_precondition": "libxml2's dequoting functions check for opening quotes and return errors, rather than having an assertion/precondition for already-valid quoted tokens.",
    "caller_ignoring_sentinel": "No libxml2 caller follows the pattern of ignoring a tokenizer sentinel before invoking a dequote helper."
  },
  "llm_seconds": 268.3
}