  "rationale": {
    "tokenizer": "Lua's lexer returns token type directly and raises errors for invalid input; it has no tokenizer that returns a length and writes a token type out-param.",
    "dequote_helper": "Lua's string lexing is done inside read_string without a separate dequote helper that assumes a valid quoted token.",
    "illegal_token_sentinel": "Lua's lexer has no illegal-token sentinel; it invokes error handling for invalid input.",
    "dequoter_with_precondition": "Lua has no dequoter function with a precondition/assertion for valid quoted tokens.",
    "caller_ignoring_sentinel": "There is no Lua caller that ignores an illegal-token sentinel before invoking a dequote helper."
  },
