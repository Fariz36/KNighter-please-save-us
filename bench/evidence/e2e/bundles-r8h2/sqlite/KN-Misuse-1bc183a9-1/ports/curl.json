  "rationale": {
    "tokenizer": "curlx_str_quotedword parses a quoted token, writes the token text and length to an out-parameter, and returns an error sentinel for invalid/corrupt input.",
    "dequote_helper": "parse_cert_parameter copies token text and dequotes it, assuming the token is a syntactically valid quoted string.",
    "illegal_token_sentinel": "curl's strparse helpers use a generic non-zero error return rather than a named illegal-token sentinel constant.",
    "dequoter_with_precondition": "curlx_str_quotedword dequotes a quoted word and has a precondition that the input starts with a valid quote.",
    "caller_ignoring_sentinel": "parse_cert_parameter can ignore the error return of curlx_str_quotedword before using the dequoted token."
  },
