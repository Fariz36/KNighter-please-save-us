  "rationale": {
    "buffer_grow": "curl's mprintf uses a fixed output buffer and has no capacity-reserving grow function within the formatter; dynamic buffer growth is handled elsewhere and does not follow the same pattern.",
    "required_capacity": "curl's mprintf does not compute a separate required-capacity variable before writing; it writes up to a fixed maximum size.",
    "write_pointer": "curl's mprintf writes to the output buffer via the storebuffer callback using an index, not through a direct pointer into the output buffer.",
    "digit_set": "curl's lib/mprintf.c uses a static digit character array named digits for integer and hexadecimal conversions.",
    "output_buffer": "The output buffer in curl's formatf function is accessed through the struct member m->buffer in struct Curl_mprintf."
  },
  "llm_seconds": 223.3
