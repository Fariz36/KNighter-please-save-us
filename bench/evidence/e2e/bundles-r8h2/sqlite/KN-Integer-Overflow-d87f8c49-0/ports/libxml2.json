  "rationale": {
    "length_of": "xmlUTF8Strsize computes the byte length of the first len UTF-8 characters by scanning characters and subtracting the start pointer.",
    "character_count_bound": "These functions take an integer len that bounds the number of UTF-8 characters to process.",
    "iterator_advance": "xmlUTF8Size returns the byte size of one UTF-8 character and xmlGetUTF8Char parses a UTF-8 character and reports its byte length, both used to advance through UTF-8 strings.",
    "output_length": "The signed int returned by xmlUTF8Strsize receives the measured byte length that is later used as a copy or append length.",
    "narrowing_cast": "No named function or macro corresponds to the C integer cast; the narrowing occurs as a built-in cast inside xmlUTF8Strsize.",
    "safe_cap": "The MIN macro is libxml2's general-purpose clamp and is the equivalent of SQLite's MIN used to cap lengths before narrowing.",
    "buffer_append": "These functions copy or append a bounded byte buffer using a signed or size_t length, and can consume a possibly overflowed length from xmlUTF8Strsize."
  },
  "llm_seconds": 170.2
