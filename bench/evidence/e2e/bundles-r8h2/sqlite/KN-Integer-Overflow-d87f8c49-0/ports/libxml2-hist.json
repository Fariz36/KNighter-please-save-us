  "rationale": {
    "length_of": "xmlUTF8Strsize computes the byte length of the first len UTF-8 characters, matching the pointer-difference length after a UTF-8 scan.",
    "character_count_bound": "len is the integer parameter that bounds the number of logical characters scanned in functions like xmlUTF8Strsize.",
    "iterator_advance": "These functions determine or perform advancing over one UTF-8 character (1-4 bytes) in a byte string or parser input.",
    "output_length": "size is the signed int variable that commonly receives the byte length from xmlUTF8Strsize before being used for allocation/copy/append.",
    "narrowing_cast": "libxml2 performs the narrowing implicitly via the int return type of xmlUTF8Strsize; there is no named cast macro or function.",
    "safe_cap": "libxml2 does not have the SQLite-style MIN(..., 0x7ffffff0) clamp in the analogous code, so no safe-cap identifier exists.",
    "buffer_append": "These functions append a bounded byte buffer using a length argument to an output accumulator."
  },
  "llm_seconds": 179.1
