  "rationale": {
    "length_of": "curl has no function/macro that computes a byte length via pointer subtraction after a UTF-8 character scan.",
    "character_count_bound": "curl does not have an equivalent precision bound for UTF-8 character scanning; printf precision is byte-based.",
    "iterator_advance": "curl has no UTF-8 character skip macro/function equivalent to SQLITE_SKIP_UTF8.",
    "output_length": "curl does not have a specific signed int variable role for this pattern.",
    "narrowing_cast": "curl has no integer narrowing cast macro equivalent to this role.",
    "safe_cap": "CURLMIN is curl's macro for clamping a value to a maximum, analogous to MIN.",
    "buffer_append": "curlx_dyn_addn appends a byte buffer of given length to a dynamic buffer, analogous to sqlite3_str_append."
  },
