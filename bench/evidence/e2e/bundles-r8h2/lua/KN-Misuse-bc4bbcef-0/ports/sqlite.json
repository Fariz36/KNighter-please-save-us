  "rationale": {
    "combined_create_and_publish": "Both functions allocate a Table and immediately insert it into the schema hash before subsequent fallible initialization (column parsing or virtual-table connection) completes.",
    "object_initializer": "These functions perform fallible initialization of a newly created Table (adding columns/constraints or connecting a virtual table) and can raise OOM after the Table is already published.",
    "persistent_registry_lookup": "sqlite3FindTable safely looks up an existing Table in the schema hash by name, the persistent registry analog to luaL_getmetatable.",
    "object_allocator": "SQLite has no dedicated Table allocator separate from sqlite3StartTable; allocation is done inline with sqlite3MallocZero.",
    "registry_store": "sqlite3HashInsert publishes the fully initialized Table into the schema hash, the registry store analog to lua_setfield.",
    "registry_key": "The registry key is the table name string stored in Table.zName; SQLite has no dedicated macro or function for this key."
  },
  "llm_seconds": 244.5
