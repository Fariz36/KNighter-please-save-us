  "rationale": {
    "combined_create_and_publish": "curl does not have a single function that creates an object and publishes it into a persistent registry before initialization; creation and publication are separate operations.",
    "object_initializer": "These fallible initializers can fail (return CURLcode or a pointer) and are used to initialize newly created objects.",
    "persistent_registry_lookup": "These functions safely look up an existing object in a persistent registry (metadata hash or alt-svc list) by key.",
    "object_allocator": "These general and object-specific allocation functions allocate a new object locally without publishing it.",
    "registry_store": "These functions publish an initialized object into a persistent registry (metadata hash, cert store cache, or SSL_CTX store).",
    "registry_key": "This function constructs the key used to look up or store an object in the SSL session cache registry."
  },
  "llm_seconds": 240.0
