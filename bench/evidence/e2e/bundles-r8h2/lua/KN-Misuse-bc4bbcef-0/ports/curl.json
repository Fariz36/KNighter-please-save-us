  "rationale": {
    "combined_create_and_publish": "Creates a peer object and publishes it into the multi-handle peer registry in one step, analogous to luaL_newmetatable.",
    "object_initializer": "These functions create and initialize a new object and can fail, matching the fallible initializer role of luaL_setfuncs.",
    "persistent_registry_lookup": "These functions perform a safe lookup of an existing object in a persistent keyed registry, analogous to luaL_getmetatable.",
    "object_allocator": "General-purpose and object-specific allocators that allocate a new object without publishing it, analogous to luaL_newlibtable.",
    "registry_store": "These functions publish a newly created and initialized certificate store into a persistent registry (SSL context or cache), analogous to lua_setfield.",
    "registry_key": "Constructs the key used to store and retrieve objects in the SSL session cache, analogous to the BOXMT registry key."
  },
