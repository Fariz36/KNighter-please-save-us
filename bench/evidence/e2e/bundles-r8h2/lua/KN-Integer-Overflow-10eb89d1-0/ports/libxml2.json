  "rationale": {
    "decoder_function": "xmlGetUTF8Char is the core UTF-8 decoder in libxml2; xmlStringCurrentChar and xmlCurrentChar are wrappers that read and decode the current character from input.",
    "input_byte": "In xmlGetUTF8Char, the first byte of the UTF-8 sequence is stored in the local variable c (initialized from utf[0]).",
    "continuation_count": "The total number of bytes in the UTF-8 sequence (continuation count + 1) is held in l and returned via len in xmlGetUTF8Char; xmlUTF8Size and xmlUTF8Strsize compute this byte count for UTF-8 characters and strings."
  },
