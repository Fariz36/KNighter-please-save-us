  "rationale": {
    "gc_managed_object": "Table is the Lua type whose instances are garbage-collected and can be accessed via C pointers.",
    "potential_gc_trigger": "luaH_finishset can allocate or rehash and thus trigger an emergency garbage collection.",
    "gc_root_anchor": "sethvalue2s places a table value on the Lua stack, making it visible to the GC as a root.",
    "weak_reference_container": "__mode is the metatable field that marks tables as weak, so they do not keep referenced objects alive.",
