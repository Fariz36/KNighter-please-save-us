+// Helper: Checks if an expression is a null pointer constant.
+static bool isNullPointerConstant(const Expr *E, ASTContext &Ctx) {
+  return E->isNullPointerConstant(Ctx, Expr::NPC_ValueDependentIsNull);
+}
+
+// Helper: Checks if the condition is a comparison of the given field to NULL.
+// If so, sets IsNullIfTrue to true if the true branch implies the field is null,
+// false if the false branch implies the field is null.
+static bool isFieldNullCheck(const Expr *Cond, const FieldDecl *FD,
+                             ASTContext &Ctx, bool &IsNullIfTrue) {
+  Cond = Cond->IgnoreImpCasts();
+  const BinaryOperator *BO = dyn_cast<BinaryOperator>(Cond);
+  if (!BO || (!BO->isEqualityOp()))
+    return false;
+  const Expr *LHS = BO->getLHS()->IgnoreImpCasts();
+  const Expr *RHS = BO->getRHS()->IgnoreImpCasts();
+  const MemberExpr *ME = nullptr;
+  const Expr *Other = nullptr;
+  if (const MemberExpr *ME1 = dyn_cast<MemberExpr>(LHS)) {
+    ME = ME1;
+    Other = RHS;
+  } else if (const MemberExpr *ME2 = dyn_cast<MemberExpr>(RHS)) {
+    ME = ME2;
+    Other = LHS;
+  } else {
+    return false;
+  }
+  if (ME->getMemberDecl() != FD)
+    return false;
+  if (!isNullPointerConstant(Other, Ctx))
+    return false;
+  bool isEq = BO->getOpcode() == BO_EQ;
+  IsNullIfTrue = isEq;
+  return true;
+}
+
+// Helper: Checks if Child is contained within Parent (including Parent itself).
+static bool containsStmt(const Stmt *Parent, const Stmt *Child) {
+  if (!Parent || !Child)
+    return false;
+  if (Parent == Child)
+    return true;
+  for (const Stmt *S : Parent->children()) {
+    if (containsStmt(S, Child))
+      return true;
+  }
+  return false;
+}
