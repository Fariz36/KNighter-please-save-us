+
+unsigned SAGenTestChecker::getMaxZeroGeneration(const MemRegion *MR,
+                                                ProgramStateRef State,
+                                                bool &Found) const {
+  Found = false;
+  unsigned MaxGen = 0;
+  const MemRegion *R = MR;
+  while (R) {
+    if (const unsigned *Gen = State->get<ZeroedRegions>(R)) {
+      if (!Found || *Gen > MaxGen) {
+        MaxGen = *Gen;
+        Found = true;
+      }
+    }
+
+    const auto *SR = llvm::dyn_cast<SubRegion>(R);
+    if (!SR)
+      break;
+    R = SR->getSuperRegion();
+  }
+  return MaxGen;
+}
 
