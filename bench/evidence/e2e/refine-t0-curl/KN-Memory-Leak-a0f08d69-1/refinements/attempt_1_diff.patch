 namespace {
+
+bool ExprHasName(const Expr *E, StringRef Name, CheckerContext &) {
+  if (!E)
+    return false;
+  const CallExpr *CE = llvm::dyn_cast<CallExpr>(E);
+  if (!CE)
+    return false;
+  const FunctionDecl *FD = CE->getDirectCallee();
+  if (!FD)
+    return false;
+  return FD->getName() == Name;
+}
+
+const MemRegion *getMemRegionFromExpr(const Expr *E, CheckerContext &C) {
+  if (!E)
+    return nullptr;
+  SVal V = C.getState()->getSVal(E, C.getLocationContext());
+  return V.getAsRegion();
+}
+
+bool EvaluateExprToInt(llvm::APSInt &Result, const Expr *E, CheckerContext &C) {
+  if (!E)
+    return false;
+  Expr::EvalResult EvalResult;
+  if (!E->EvaluateAsInt(EvalResult, C.getASTContext()))
+    return false;
+  Result = EvalResult.Val.getInt();
+  return true;
+}
 
