  "rationale": {
    "length_of": "These functions compute the length of a NUL-terminated string by scanning for a terminator, matching strlen in curl.",
    "untrusted_size": "These functions provide the length of a length-delimited buffer or data source, analogous to ASN1_STRING_length and ASN1_STRING_to_UTF8's returned length.",
    "untrusted_data_accessor": "These functions return a pointer to raw, length-delimited buffer data that may not be NUL-terminated, analogous to ASN1_STRING_get0_data.",
    "allocator": "These functions allocate memory and return a pointer, often used to create strings or buffers from untrusted data, analogous to ASN1_STRING_to_UTF8.",
    "deallocator": "These functions free memory or objects, corresponding to OPENSSL_free, and cover both general-purpose and object-specific deallocators in libxml2.",
    "error_setter": "These are the printf-style error reporting functions in libxml2 that take a format string and varargs, analogous to failf and infof."
  },
  "llm_seconds": 112.7
