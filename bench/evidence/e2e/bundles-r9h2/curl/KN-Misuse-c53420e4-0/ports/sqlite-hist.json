  "rationale": {
    "length_of": "SQLite uses strlen and its bounded variant sqlite3Strlen30 to compute NUL-terminated string lengths by scanning for a terminator.",
    "untrusted_size": "These functions return the byte length of length-delimited SQLite values/blobs or LSM page data, analogous to ASN1_STRING_length.",
    "untrusted_data_accessor": "These return pointers to raw, length-delimited buffers that may not be NUL-terminated, like ASN1_STRING_get0_data.",
    "allocator": "These are SQLite's general-purpose raw memory allocators that return buffers which may not be NUL-terminated, similar to ASN1_STRING_to_UTF8.",
    "deallocator": "These are SQLite's general-purpose and object-specific free functions, analogous to OPENSSL_free.",
    "error_setter": "These are SQLite's printf-style error/info reporting functions that may use %s on untrusted buffers, like failf/infof."
  },
