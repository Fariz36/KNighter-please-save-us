# Ignore Mac system files
.DS_Store

# Ignore result
result/

# Ignore __pycache__
__pycache__/

# Ignore test
test/

# Skip config files
# config.json

# Ignore temp data
tmp/

# Ignore key files
llm_keys.yaml

# Ignore result dir
result*

*/logs/

llvm-*
*.zip

*/tmp

# Generated: logs, tree-sitter build, benchmark runs
logs/
src/kparser/build/
bench/runs/
bench/replay/
bench/*.out
bench/snapshots/
.venv/
/e2e/

# Committed evidence behind docs/RESULTS_*.md (overrides the result* rule above)
!bench/evidence/**/results
!bench/evidence/**/results/**
!bench/evidence/**/results-*
!bench/evidence/**/results-*/**
!bench/evidence/**/results.jsonl
